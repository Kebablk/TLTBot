generator client {
  provider = "prisma-client"
  output   = "../src/generated"
}

datasource db {
  provider = "postgresql"
}

model DailyData {
  id        String   @id @default(uuid())
  date      String   @unique
  open      Float?
  close     Float?
  fedRate   Float?
  inflation Float?
  dividend  Float?
  nominalYield Float?
  realYield Float?
  
  annualPeak Boolean?
  previousBottom Boolean?
  volumetricPanic Boolean?
  annualMinimum Boolean?
  RSI Boolean?
  realYieldConf Boolean?
  fedRateConf Boolean?
  MA50 Boolean?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

