generator client {
  provider = "prisma-client"
}

datasource db {
  provider = "postgresql"
}

model DailyData {
  id        String  @id @default(uuid())
  date      String  @unique
  open      Float?
  close     Float?
  fedRate   Float?
  inflation Float?
  dividend  Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
